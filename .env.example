# Copy to .env.local and fill in real values. NEVER commit real secrets to this file.

# --- Core ---
APP_URL="https://careers.fajracademy.io"          # public base URL (payment return / IPN links)
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/fajrtraining
JWT_SECRET=<long-random-string>                   # required in production (openssl rand -hex 32)

# --- SSLCommerz (payment gateway) ---
SSLCOMMERZ_STORE_ID=<store-id>
SSLCOMMERZ_STORE_PASSWORD=<store-password>
SSLCOMMERZ_IS_LIVE=false

# --- Email (Gmail SMTP) ---
GMAIL_USER=<gmail-address>
GMAIL_APP_PASSWORD=<gmail-app-password>

# --- Media uploads ---
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
IMAGEKIT_PUBLIC_KEY=<public-key>
IMAGEKIT_PRIVATE_KEY=<private-key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<id>

# --- Pusher (realtime) ---
PUSHER_APP_ID=<app-id>
PUSHER_APP_KEY=<app-key>
PUSHER_APP_SECRET=<app-secret>
PUSHER_KEY=<key>
PUSHER_SECRET=<secret>
PUSHER_CLUSTER=ap1
NEXT_PUBLIC_PUSHER_KEY=<key>
NEXT_PUBLIC_PUSHER_CLUSTER=ap1

# --- Google Calendar / Meet ---
GOOGLE_OAUTH_CLIENT_ID=<client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<refresh-token>
GOOGLE_CLIENT_EMAIL=<service-account-email>

# --- Telegram ---
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CEO_CHAT_ID=<chat-id>

SUPER_PASSWORD=<unused-or-set-locally>

# --- Default (first) admin — also works in PRODUCTION ---
# On a database with no active admin, the server creates this super-admin on its first
# start (or run `pnpm seed:admin`). Existing accounts are never changed. After the first
# sign-in, change the password (Admin → অ্যাডমিন ইউজার → key icon) and you may remove these.
DEFAULT_ADMIN_EMAIL=<admin-email>
DEFAULT_ADMIN_PASSWORD=<at-least-10-characters>
DEFAULT_ADMIN_NAME=System Administrator
DEFAULT_ADMIN_PHONE=

# Accounts are stored in three collections:
#   users       → admins           (Admin → অ্যাডমিন ইউজার)
#   instructors → instructors      (Admin → ইনস্ট্রাক্টর)
#   tots        → paying trainees  (Admin → TOT ট্রেইনি, or created automatically after payment)
#
# Demo accounts on a fresh local database: run the dev server and open
#   http://localhost:3000/api/seed      (development only — prints the demo logins)
